{
  "name": "expbuilder",
  "version": "2.4.1",
  "description": "Experiment Builder App",
  "author": {
    "name": "Andrés Pacheco Fabián",
    "email": "andngdv.lpr@gmail.com"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "electron-builder": "26.15.7",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "file-loader": "^6.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "ai": "^6.0.177",
    "cheerio": "^1.1.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "json2csv": "^6.0.0-alpha.2",
    "jszip": "^3.10.1",
    "lowdb": "^7.0.1",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^2.2.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "@jest/reporters": {
      "glob": "13.0.6"
    },
    "babel-plugin-istanbul": "8.0.0",
    "ejs": "6.0.1",
    "jest-config": {
      "glob": "13.0.6"
    },
    "jest-runtime": {
      "glob": "13.0.6"
    },
    "rimraf": {
      "glob": "13.0.6"
    },
    "test-exclude": "8.0.0"
  },
  "main": "main.js",
  "type": "module",
  "scripts": {
    "electron": "electron .",
    "build": "node scripts/build.mjs",
    "build:electron": "electron-builder",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "transform": {},
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json"
    ],
    "collectCoverageFrom": [
      "*.js",
      "server/**/*.js",
      "!eslint.config.js",
      "!preload.js",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!client/**",
      "!coverage/**",
      "!landing-page/**",
      "!server/agent/docs-content.js",
      "!server/cloudflared/**",
      "!server/custom-plugins/**",
      "!server/dynamicplugin/**",
      "!server/jspsych-bundle/**",
      "!server/jspsych-bundler/**"
    ],
    "coverageDirectory": "coverage",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/landing-page/",
      "/server/cloudflared/",
      "/server/dynamicplugin/",
      "/server/jspsych-bundle/",
      "/server/jspsych-bundler/",
      "/client/"
    ]
  },
  "build": {
    "productName": "ExpBuilder",
    "appId": "com.flowlab.id",
    "publish": [
      {
        "provider": "github",
        "owner": "adndvlp",
        "repo": "expbuilder"
      }
    ],
    "files": [
      "main.js",
      "oauth-handler.js",
      "preload.js",
      ".env.production",
      "server/**",
      "!server/cloudflared/**",
      "!server/dynamicplugin/node_modules",
      "!server/dynamicplugin/components",
      "!server/dynamicplugin/response_components",
      "!server/dynamicplugin/package-lock.json",
      "!server/jspsych-bundler/**",
      "!server/__tests__/**",
      "!landing-page"
    ],
    "extraResources": [
      {
        "from": "client/dist",
        "to": "client/dist"
      },
      {
        "from": "server/cloudflared",
        "to": "cloudflared"
      }
    ],
    "icon": "icon/icon.png",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        "AppImage",
        "zip"
      ],
      "icon": "icon/icon.png"
    }
  }
}
