rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if(request.auth.uid == userId);
      allow write: if(request.auth.uid == userId) && 
        request.resource.data.keys().hasOnly(['email', 'experiments', 'dropboxTokens', 'googleDriveTokens', 'githubTokens', 'osfTokens', 'osfTokenValid', 'osfUserId', 'osfUserName', 'osfProjectId', 'uid']) &&
        (request.resource.data.uid == userId);
      allow delete: if(request.auth.uid == userId);
    }
    match /experiments/{experimentId}/session_metadata/{sessionId} {
      allow read: if request.auth.uid != null &&
        get(/databases/$(database)/documents/experiments/$(experimentId)).data.owner == request.auth.uid;
      allow write: if false;
    }
    match /experiments/{experimentId}/session_metadata/{sessionId}/participant_files/{fileId} {
      allow read: if request.auth.uid != null &&
        get(/databases/$(database)/documents/experiments/$(experimentId)).data.owner == request.auth.uid;
      allow write: if false;
    }
    match /experiments/{experimentId}/publication_attempts/{attemptId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/experiments/$(experimentId)).data.owner == request.auth.uid;
      allow write: if false;
    }
    match /experiments/{experimentId} {
      function isOwner(){
        return request.auth != null && request.auth.uid == resource.data.owner;
      }
      allow read: if isOwner();
      // Creation and deletion go through the backend's ownership/provisioning policy.
      allow create, delete: if false;
      // Functional settings are local drafts; only publication writes their remote snapshot.
      // Operational switches remain editable without allowing counters or identity changes.
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'active', 'title', 'useValidation', 'allowJSON', 'allowCSV', 'requiredFields',
        'maxSessions', 'limitSessions', 'activeConditionAssignment', 'nConditions'
      ]) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['active']) ||
        ( (!('provisioningState' in resource.data) || resource.data.provisioningState == 'ready') &&
          (!('initialPublicationPending' in resource.data) || resource.data.initialPublicationPending == false)));
    }
  }
}
